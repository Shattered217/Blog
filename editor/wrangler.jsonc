{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "nvcc-v-blog-editor",
	"main": "./src/index.ts",
	"compatibility_date": "2026-08-08",
	"workers_dev": false,
	"routes": [
		{
			"pattern": "editor.nvcc-v.com",
			"custom_domain": true
		}
	],
	"vars": {
		"REQUIRE_ACCESS": "true"
	},
	"d1_databases": [
		{
			"binding": "BLOG_DB",
			"database_name": "nvcc-v-blog",
			"database_id": "1138d96d-5dc8-4bf2-9cfd-6e14ecf6133c"
		}
	],
	"observability": {
		"enabled": true
	}
}
