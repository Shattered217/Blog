{
  "name": "fuwari",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "tsc --noEmit",
    "new-post": "node scripts/new-post.js",
    "import-wordpress": "node scripts/import-wordpress.mjs",
    "content:compact": "node scripts/compact-imported-content.mjs",
    "media:manifest": "node scripts/media-manifest.mjs",
    "media:dimensions": "node scripts/media-dimensions.mjs",
    "test:media-references": "node --test scripts/media-reference-paths.test.mjs",
    "content:image-alt": "node scripts/enrich-image-alt.mjs",
    "media:upload": "node scripts/upload-media-r2.mjs",
    "worker:functions": "wrangler pages functions build functions --outdir .worker --project-directory . --build-output-directory dist --fallback-service ASSETS --compatibility-date 2026-08-07 --minify",
    "worker:build": "corepack pnpm build && corepack pnpm worker:functions",
    "worker:dev": "corepack pnpm worker:build && wrangler dev --config wrangler.worker.jsonc",
    "worker:deploy:preview": "corepack pnpm worker:build && wrangler deploy --config wrangler.worker.jsonc",
    "worker:deploy": "corepack pnpm release:check && wrangler deploy --config wrangler.worker.jsonc --env production",
    "editor:dev": "wrangler dev --config editor/wrangler.jsonc --var REQUIRE_ACCESS:false",
    "editor:test": "node --experimental-strip-types --test editor/src/*.test.ts editor/src/*.test.mjs",
    "editor:deploy": "corepack pnpm release:check && wrangler deploy --config editor/wrangler.jsonc",
    "validate:migration": "node scripts/validate-migration.mjs",
    "seo:audit": "node scripts/audit-built-seo.mjs",
    "seo:submit:indexnow": "node scripts/submit-indexnow.mjs",
    "format": "biome format --write ./src",
    "lint": "biome check --write ./src",
    "preinstall": "npx only-allow pnpm",
    "check:worker": "tsc -p tsconfig.worker.json",
    "lint:check": "biome ci ./src ./functions ./editor/src ./scripts",
    "test": "node --experimental-strip-types --test functions/tests/*.test.mjs editor/src/*.test.ts editor/src/*.test.mjs scripts/*.test.mjs",
    "worker:dry-run": "wrangler deploy --dry-run --config wrangler.worker.jsonc --env production",
    "editor:dry-run": "wrangler deploy --dry-run --config editor/wrangler.jsonc",
    "validate:source": "corepack pnpm check && corepack pnpm check:worker && corepack pnpm lint:check && corepack pnpm test",
    "validate:build": "corepack pnpm worker:build && corepack pnpm validate:migration && corepack pnpm seo:audit && corepack pnpm worker:dry-run && corepack pnpm editor:dry-run",
    "release:check": "corepack pnpm validate:source && corepack pnpm validate:build"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/rss": "4.0.19",
    "@astrojs/svelte": "9.1.1",
    "@expressive-code/core": "0.44.3",
    "@expressive-code/plugin-collapsible-sections": "0.44.3",
    "@expressive-code/plugin-line-numbers": "0.44.3",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.96",
    "@iconify/svelte": "^4.2.0",
    "@swup/astro": "1.8.0",
    "@tailwindcss/typography": "^0.5.20",
    "astro": "7.4.2",
    "astro-expressive-code": "0.44.3",
    "astro-icon": "1.2.0",
    "hastscript": "^9.0.1",
    "jose": "^6.2.13",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "mdast-util-to-string": "^4.0.0",
    "overlayscrollbars": "^2.17.0",
    "pagefind": "^1.5.2",
    "photoswipe": "^5.4.4",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-components": "^0.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^3.0.1",
    "remark-directive-rehype": "^0.4.2",
    "remark-github-admonitions-to-directives": "^1.0.5",
    "remark-math": "^6.0.0",
    "remark-sectionize": "^2.1.0",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "stylus": "^0.64.0",
    "svelte": "5.57.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.12",
    "@biomejs/biome": "2.2.5",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@rollup/plugin-yaml": "^4.1.2",
    "@types/hast": "^3.0.5",
    "@types/markdown-it": "^14.2.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@types/sanitize-html": "^2.16.2",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.31",
    "postcss-import": "^16.2.0",
    "postcss-nesting": "^13.0.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "wrangler": "^4.152.0"
  },
  "packageManager": "pnpm@9.14.4",
  "engines": {
    "node": ">=22.23.4"
  },
  "pnpm": {
    "patchedDependencies": {
      "braces@3.0.3": "patches/braces@3.0.3.patch"
    },
    "overrides": {
      "postcss-selector-parser@<7.1.6": "7.1.6",
      "serialize-javascript@<7.0.5": "7.0.5",
      "katex@<0.18.2": "0.19.0"
    }
  }
}
