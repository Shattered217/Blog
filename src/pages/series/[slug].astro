---
import PostPage from "@components/PostPage.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import {
	getSeriesGroups,
	getSortedPosts,
	type SeriesGroup,
} from "@utils/content-utils";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
	const groups = getSeriesGroups(await getSortedPosts());
	return groups.map((series) => ({
		params: { slug: series.slug },
		props: { series },
	}));
}

const { series } = Astro.props as { series: SeriesGroup };
---

<MainGridLayout title={series.name} description={`${series.name}系列按阅读顺序整理，共 ${series.posts.length} 篇文章，集中记录相关环境配置、部署步骤与问题排查。`}>
    <div class="card-base rounded-[var(--radius-large)] px-7 py-6 md:px-9 mb-4 flex items-center justify-between gap-5">
        <div>
            <p class="text-sm font-semibold tracking-[0.14em] text-[var(--primary)] mb-1">ARTICLE SERIES</p>
            <h1 class="text-3xl font-bold text-90">{series.name}</h1>
            <p class="text-50 mt-2">按阅读顺序整理，共 {series.posts.length} 篇。</p>
        </div>
        <Icon name="material-symbols:book-5-outline-rounded" class="hidden sm:block text-5xl text-[var(--primary)]/70 shrink-0" />
    </div>
    <PostPage page={{ data: series.posts }} />
</MainGridLayout>
