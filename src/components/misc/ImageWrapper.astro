---
import path from "node:path";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	loading?: "eager" | "lazy";
	decoding?: "async" | "auto" | "sync";
	fetchpriority?: "high" | "low" | "auto";
}

import { Image } from "astro:assets";
import {
	getInternalMediaPath,
	getMediaDimensions,
} from "../../utils/media-utils";
import { url } from "../../utils/url-utils";

const {
	id,
	src,
	alt,
	position = "center",
	basePath = "/",
	loading = "lazy",
	decoding = "async",
	fetchpriority,
} = Astro.props;
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const internalMediaPath = getInternalMediaPath(src);
const isPublic = src.startsWith("/");
const dimensions = internalMediaPath ? getMediaDimensions(src) : undefined;
const displaySource = internalMediaPath
	? url(internalMediaPath)
	: isPublic
		? url(src)
		: src;

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
// biome-ignore lint/suspicious/noImplicitAnyLet: <check later>
let img;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>("../../**", {
		import: "default",
	});
	let normalizedPath = path
		.normalize(path.join("../../", basePath, src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(
			`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
		);
	}
	img = await file();
}

const imageClass = "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>
    {isLocal && img && <Image src={img} alt={alt || ""} loading={loading} decoding={decoding} fetchpriority={fetchpriority} class={imageClass} style={imageStyle}/>}
    {!isLocal && <img src={displaySource} alt={alt || ""} loading={loading} decoding={decoding} fetchpriority={fetchpriority} width={dimensions?.width} height={dimensions?.height} class={imageClass} style={imageStyle}/>}
</div>
