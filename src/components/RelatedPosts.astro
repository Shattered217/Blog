---
import type { CollectionEntry } from "astro:content";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getPostUrl } from "@utils/url-utils";
import { Icon } from "astro-icon/components";

interface Props {
	posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
    <section class="card-base rounded-[var(--radius-large)] px-6 py-6 md:px-8 mb-4">
        <div class="flex items-end justify-between gap-4 mb-4">
            <div>
                <p class="text-xs tracking-[0.16em] text-[var(--primary)] font-bold mb-1">KEEP EXPLORING</p>
                <h2 class="text-xl font-bold text-90">相关文章</h2>
            </div>
            <Icon name="material-symbols:auto-stories-outline-rounded" class="text-3xl text-[var(--primary)]/70" />
        </div>
        <div class="grid gap-2">
            {posts.map((post, index) => (
                <a
                    href={getPostUrl(post.slug, post.data.published, post.data.permalink)}
                    class="group flex items-center gap-4 rounded-2xl p-3 bg-black/[0.025] dark:bg-white/[0.035] hover:bg-[var(--primary)]/10 transition"
                >
                    <span class="size-9 shrink-0 rounded-xl bg-[var(--primary)]/15 text-[var(--primary)] font-bold flex items-center justify-center">
                        {String(index + 1).padStart(2, "0")}
                    </span>
                    <div class="min-w-0 flex-1">
                        <h3 class="font-semibold text-90 line-clamp-1 group-hover:text-[var(--primary)] transition">{post.data.title}</h3>
                        <p class="text-xs text-50 mt-1">{formatDateToYYYYMMDD(post.data.published)} · {post.data.tags.slice(0, 2).join(" / ")}</p>
                    </div>
                    <Icon name="material-symbols:chevron-right-rounded" class="text-2xl text-[var(--primary)] shrink-0" />
                </a>
            ))}
        </div>
    </section>
)}
