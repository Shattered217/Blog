---
import { Icon } from "astro-icon/components";
import { friendLinks } from "../data/friends";
---

<div class="space-y-5">
    <div class="card-base rounded-[var(--radius-large)] px-7 py-6 md:px-9">
        <div class="flex items-start justify-between gap-4">
            <div>
                <p class="text-sm font-medium text-[var(--primary)] mb-1">NEIGHBORS ON THE WEB</p>
                <h1 class="text-3xl font-bold text-90">友情链接</h1>
                <p class="text-50 mt-2">认识有趣的人，也让彼此的站点在互联网上留一扇门。</p>
            </div>
            <div class="shrink-0 rounded-full px-3 py-1.5 text-sm font-semibold bg-[var(--primary)]/15 text-[var(--primary)]">
                {friendLinks.length} 个站点
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        {friendLinks.map((friend, index) => (
            <a
                href={friend.url}
                target="_blank"
                rel="friend noopener noreferrer"
                class="card-base group rounded-[var(--radius-large)] p-4 flex items-center gap-4 transition hover:-translate-y-0.5 hover:shadow-lg"
                style={`animation-delay: ${index * 35}ms`}
            >
                <div class="relative size-14 shrink-0 rounded-2xl overflow-hidden bg-[var(--primary)]/15 flex items-center justify-center text-[var(--primary)] font-bold text-xl">
                    <span>{friend.name.slice(0, 1)}</span>
                    <img
                        src={friend.avatar}
                        alt={`${friend.name} 的头像`}
                        loading="lazy"
                        decoding="async"
                        referrerpolicy="no-referrer"
                        onerror="this.remove()"
                        class="absolute inset-0 size-full object-cover"
                    />
                </div>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <h2 class="font-bold text-90 truncate group-hover:text-[var(--primary)] transition">{friend.name}</h2>
                        <Icon name="fa6-solid:arrow-up-right-from-square" class="text-xs text-30 group-hover:text-[var(--primary)] transition" />
                    </div>
                    <p class="text-sm text-50 mt-1 line-clamp-2">{friend.description}</p>
                </div>
            </a>
        ))}
    </div>

    <div class="card-base rounded-[var(--radius-large)] px-7 py-5 text-sm text-50">
        想交换友链，可以通过 <a class="link-lg text-[var(--primary)]" href="mailto:me@shattered.top">Email</a> 联系我。
    </div>
</div>
