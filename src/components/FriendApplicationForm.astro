---
const turnstileSiteKey = "0x4AAAAAAEJW7Peo4URbG2_J";
---

<friend-application-form class="block card-base rounded-[var(--radius-large)] px-6 py-6 md:px-8">
    <div class="mb-5">
        <p class="text-xs tracking-[0.16em] text-[var(--primary)] font-bold mb-1">JOIN THE NEIGHBORHOOD</p>
        <h2 class="text-2xl font-bold text-90">申请友链</h2>
        <p class="text-sm text-50 mt-2">填写后会进入待审核列表。保持站点可访问、有持续内容即可。</p>
    </div>

    <form action="/api/friend-applications" method="post" class="grid gap-4">
        <div class="grid md:grid-cols-2 gap-4">
            <label class="grid gap-1.5 text-sm font-semibold text-75">
                站点名称
                <input name="name" required maxlength="60" autocomplete="organization" class="h-11 rounded-xl bg-black/[0.035] dark:bg-white/[0.06] border border-transparent focus:border-[var(--primary)] outline-none px-4 transition" placeholder="例如：碎裂之地" />
            </label>
            <label class="grid gap-1.5 text-sm font-semibold text-75">
                站点地址
                <input name="url" type="url" required maxlength="300" autocomplete="url" class="h-11 rounded-xl bg-black/[0.035] dark:bg-white/[0.06] border border-transparent focus:border-[var(--primary)] outline-none px-4 transition" placeholder="https://example.com/" />
            </label>
        </div>

        <label class="grid gap-1.5 text-sm font-semibold text-75">
            头像地址 <span class="text-30 font-normal">（可选，建议正方形图片）</span>
            <input name="avatar" type="url" maxlength="500" class="h-11 rounded-xl bg-black/[0.035] dark:bg-white/[0.06] border border-transparent focus:border-[var(--primary)] outline-none px-4 transition" placeholder="https://example.com/avatar.png" />
        </label>

        <label class="grid gap-1.5 text-sm font-semibold text-75">
            一句话简介
            <textarea name="description" required minlength="2" maxlength="240" rows="3" class="rounded-xl bg-black/[0.035] dark:bg-white/[0.06] border border-transparent focus:border-[var(--primary)] outline-none px-4 py-3 resize-y transition" placeholder="介绍一下你的站点"></textarea>
        </label>

        <label class="absolute left-[-10000px]" aria-hidden="true">
            Website
            <input name="website" tabindex="-1" autocomplete="off" />
        </label>

        <div
            class="cf-turnstile min-h-[65px]"
            data-sitekey={turnstileSiteKey}
            data-action="friend_application"
            data-theme="auto"
            data-size="flexible"
        ></div>

        <div class="flex flex-col sm:flex-row sm:items-center gap-3">
            <button type="submit" class="btn-regular h-11 rounded-xl px-5 font-semibold bg-[var(--primary)] text-[var(--btn-content)] active:scale-95 transition">
                提交申请
            </button>
            <p data-form-status role="status" aria-live="polite" class="text-sm text-50"></p>
        </div>
    </form>
</friend-application-form>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
class FriendApplicationForm extends HTMLElement {
    form: HTMLFormElement | null = null;
    status: HTMLElement | null = null;

    handleSubmit = async (event: SubmitEvent) => {
        event.preventDefault();
        if (!this.form || !this.status) return;
        const submit = this.form.querySelector<HTMLButtonElement>("button[type='submit']");
        const data = new FormData(this.form);
        if (!data.get("cf-turnstile-response")) {
            this.status.textContent = "请先完成人机验证。";
            return;
        }

        submit?.setAttribute("disabled", "");
        if (submit) submit.textContent = "正在提交…";
        this.status.textContent = "";
        try {
            const response = await fetch(this.form.action, {
                method: "POST",
                body: data,
                headers: { Accept: "application/json" },
            });
            const result = await response.json() as { message?: string; error?: string };
            if (!response.ok) throw new Error(result.error || "提交失败，请稍后重试");
            this.status.textContent = result.message || "申请已提交。";
            this.status.classList.add("text-[var(--primary)]");
            this.form.reset();
            const turnstile = (window as typeof window & { turnstile?: { reset: () => void } }).turnstile;
            turnstile?.reset();
        } catch (error) {
            this.status.textContent = error instanceof Error ? error.message : "提交失败，请稍后重试";
        } finally {
            submit?.removeAttribute("disabled");
            if (submit) submit.textContent = "提交申请";
        }
    };

    connectedCallback() {
        this.form = this.querySelector("form");
        this.status = this.querySelector("[data-form-status]");
        this.form?.addEventListener("submit", this.handleSubmit);
    }

    disconnectedCallback() {
        this.form?.removeEventListener("submit", this.handleSubmit);
    }
}

if (!customElements.get("friend-application-form")) {
    customElements.define("friend-application-form", FriendApplicationForm);
}
</script>
